{
  "name": "@pnpwin/dsh-lazy-discovery",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Lazy native MCP tools and scope-aware cached skill discovery for DeepSeek Harness.",
  "license": "MIT",
  "author": "pnpwin",
  "repository": { "type": "git", "url": "https://github.com/pnpwin/dsh-lazy-discovery.git" },
  "homepage": "https://github.com/pnpwin/dsh-lazy-discovery#readme",
  "bugs": { "url": "https://github.com/pnpwin/dsh-lazy-discovery/issues" },
  "engines": { "node": ">=20.3.0", "dsh": "0.2.2-rc.1" },
  "packageManager": "pnpm@11.28.5",
  "exports": {
    ".": "./src/index.js",
    "./host": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./host/locale/*.json": "./locale/*.json",
    "./host/icon": "./icon.png"
  },
  "files": ["src", "test", "docs", "locale", "icon.png", "cordis.patch.yml", "README.md", "README.ru.md", "LICENSE", "UPSTREAM.md", "AGENTS.md"],
  "scripts": {
    "build": "node src/build.mjs",
    "check": "node src/build.mjs",
    "test": "node --test test/*.test.js",
    "benchmark:report": "node src/benchmark.mjs"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.4.3"
  }
}
